# ── Chiro — entorno raíz (referencia)
# Copiar a `.env` para desarrollo local.

# Base de datos (Postgres). Misma variable usa backend/.env
DATABASE_URL=postgres://chiro:chiro@localhost:4200/chiro?sslmode=disable

# Secreto de firma JWT (cambiar en producción)
JWT_SECRET=change-me-en-produccion

# Puerto del backend standalone (solo desarrollo)
PORT=4300

# ── Pool de conexiones ───────────────────────────────────────────────────────
# Opcionales; los defaults son los de pgx más DB_MAX_CONNS=10 / DB_MIN_CONNS=1.
#
# Producción con Supabase en transaction mode (pooler :6543, URL con
# ?pgbouncer=true) — recomendado:
#   DB_MAX_CONNS=2
#   DB_MIN_CONNS=0
#
# Si quedás en session mode (:5432), cada conexión del cliente reserva una
# sesión real de Postgres mientras esté abierta, incluso sin tráfico. Con
# pool_size limitado eso agota el pool rápido, así que conviene una sola
# conexión por instancia y liberarla enseguida:
#   DB_MAX_CONNS=1
#   DB_MIN_CONNS=0
#   DB_MAX_IDLE_SECS=60
# DB_MAX_IDLE_SECS=0 deja el default de pgx (30 min).
# DB_MAX_IDLE_SECS solo aporta en session mode; en transaction mode las
# conexiones ociosas no cuestan nada y un valor bajo solo agrega churn.

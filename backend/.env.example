# --- Base de datos ---
# URL completa de Postgres. Ejemplos:
#   Local:           postgres://chiro:chiro@localhost:5432/chiro?sslmode=disable
#   Supabase directo: postgres://postgres.[ref]:[pw]@db.[ref].supabase.co:5432/postgres?sslmode=require
#   Supabase pooler:  postgres://postgres.[ref]:[pw]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
# El pooler activa automáticamente `simple_protocol` (sin prepared statements) para compatibilidad con PgBouncer.
DATABASE_URL=postgres://chiro:chiro@localhost:5432/chiro?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=1

# --- Auth ---
# Requerido en producción. Falla al arrancar si es vacío o el default.
JWT_SECRET=cambia-esta-clave-en-produccion
RATE_LIMIT_PER_MIN=20

# --- HTTP ---
PORT=8080
# Orígenes CORS permitidos, separados por coma. * se rechaza cuando hay Authorization.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Si estás detrás de un proxy/load balancer (Vercel, Cloudflare, nginx) que setea X-Forwarded-For.
TRUSTED_PROXIES=true
# Ruta al build de la web (SvelteKit adapter-static).
WEB_DIST=../web/build

# --- admin-create (CLI) ---
# ADMIN_EMAIL=admin@dominio
# ADMIN_PASSWORD=secreta
# ADMIN_NAME=Admin
